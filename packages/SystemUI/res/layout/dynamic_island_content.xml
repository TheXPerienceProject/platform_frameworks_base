<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_gravity="top|center_horizontal">

    <!-- Background pill -->
    <View
        android:id="@+id/dynamic_island_background"
        android:layout_width="@dimen/dynamic_island_width_collapsed"
        android:layout_height="@dimen/dynamic_island_height_collapsed"
        android:layout_gravity="center"
        android:background="@drawable/dynamic_island_background"
        android:elevation="8dp" />

    <!-- Content container -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/dynamic_island_content_padding"
        android:paddingEnd="@dimen/dynamic_island_content_padding"
        android:alpha="0.0">

        <!-- Album art -->
        <ImageView
            android:id="@+id/dynamic_island_album_art"
            android:layout_width="@dimen/dynamic_island_album_size"
            android:layout_height="@dimen/dynamic_island_album_size"
            android:layout_marginEnd="@dimen/dynamic_island_content_spacing"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:clipToOutline="true"
            android:background="@drawable/dynamic_island_album_background" />

        <!-- Text content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/dynamic_island_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAppearance="@style/TextAppearance.DynamicIsland.Title"
                android:text="@string/dynamic_island_unknown_title" />

            <TextView
                android:id="@+id/dynamic_island_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAppearance="@style/TextAppearance.DynamicIsland.Subtitle"
                android:text="@string/dynamic_island_unknown_artist" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>
