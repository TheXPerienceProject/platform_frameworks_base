<resources>

     <!-- Whether to cleanup fingerprints upon connection to the daemon and when
     user switches -->
     <java-symbol type="bool" name="config_cleanupUnusedFingerprints" />

     <!-- Whether to cancel fingerprint operation if not idle -->
     <java-symbol type="bool" name="config_fpCancelIfNotIdle" />

    <!-- Light / Regular style fonts -->
    <java-symbol type="string" name="config_lightFontFamily" />
    <java-symbol type="string" name="config_regularFontFamily" />

    <!-- Whether to allow process with media UID to access CameraServiceProxy -->
    <java-symbol type="bool" name="config_allowMediaUidForCameraServiceProxy" />

    <!-- Default line spacing multiplier between hours and minutes of the keyguard clock-->
    <java-symbol type="dimen" format="float" name="keyguard_clock_line_spacing_scale" />

    <!-- Whether to force enable multi resolution configuration for camera -->
    <java-symbol type="bool" name="config_forceMultiResolution" />

    <java-symbol type="array" name="config_launcherComponents" />
    <java-symbol type="array" name="config_launcherPackages" />

    <!-- Whitelist of package names to bypass foreground service type validation -->
    <java-symbol type="array" name="config_fgsTypeValidationBypassPackages"/>

    <!-- Whitelist of package names to bypass alarm manager validation -->
    <java-symbol type="array" name="config_alarmManagerValidationBypassPackages"/>

    <!-- Whitelist of package names to bypass broadcast reciever validation -->
    <java-symbol type="array" name="config_broadcaseReceiverValidationBypassPackages"/>

    <!-- Define device configs on boot -->
    <java-symbol type="array" name="global_device_configs_override" />
    <java-symbol type="array" name="device_configs_override" />

    <!-- Whether device has dash charging support -->
    <java-symbol type="bool" name="config_hasDashCharger" />

    <!-- Whether device has warp charging support -->
    <java-symbol type="bool" name="config_hasWarpCharger" />

    <!-- Whether device has VOOC charging support -->
    <java-symbol type="bool" name="config_hasVoocCharger" />

    <!-- Whether device has turbo power charging support -->
    <java-symbol type="bool" name="config_hasTurboPowerCharger" />

    <!-- Path to fast charging status file to detect whether an oem fast charger is active -->
    <java-symbol type="string" name="config_oemFastChargerStatusPath" />

    <!-- Path to fast charging status file to detect whether an oem fast charger is active -->
    <java-symbol type="string" name="config_oemFastChargerStatusPath2" />

    <!-- Expected value from fast charging status file -->
    <java-symbol type="string" name="config_oemFastChargerStatusValue" />

    <!-- Settings Restart -->
    <java-symbol type="string" name="settings_restart_title" />
    <java-symbol type="string" name="settings_restart_message" />

    <!-- Soft restart dialog -->
    <java-symbol type="string" name="system_restart_title" />
    <java-symbol type="string" name="system_restart_message" />

    <!-- SystemUI restart dialog -->
    <java-symbol type="string" name="systemui_restart_title" />
    <java-symbol type="string" name="systemui_restart_message" />

    <!-- Launcher restart dialog -->
    <java-symbol type="string" name="launcher_restart_title" />
    <java-symbol type="string" name="launcher_restart_message" />

    <!-- Should we listen for fingerprints when the screen is off?  Devices
    with a rear-mounted sensor want this, but certain devices have
    the sensor embedded in the power key and listening all the time
    causes a poor experience. -->
    <java-symbol type="bool" name="config_fingerprintWakeAndUnlock" />

    <!-- Power menu -->
    <java-symbol type="array" name="config_restartActionsList" />

    <!-- Status bar DT2S gesture -->
    <java-symbol type="bool" name="config_dt2sGestureAvailable" />
    <java-symbol type="bool" name="config_dt2sGestureEnabledByDefault" />

    <!-- Whether device supports an alt. ambient display -->
    <java-symbol type="bool" name="config_alt_ambient_display"/>

    <!-- Device keyhandlers -->
    <java-symbol type="array" name="config_deviceKeyHandlerLibs" />
    <java-symbol type="array" name="config_deviceKeyHandlerClasses" />

    <!-- Whether device has physical tri state switch -->
    <java-symbol type="bool" name="config_hasAlertSlider" />

    <!-- The location of the devices physical tri state switch -->
    <java-symbol type="integer" name="config_alertSliderLocation" />

    <!-- Whether key handler sends intent when changing slider position -->
    <java-symbol type="string" name="config_alertSliderIntent" />

    <!-- Pocket Lock -->
    <java-symbol type="layout" name="pocket_lock_view" />

    <!-- Pocket bridge -->
    <java-symbol type="string" name="config_pocketBridgeSysfsInpocket" />
    <java-symbol type="bool" name="config_pocketModeSupported" />
    <java-symbol type="bool" name="config_pocketUseLightSensor" />

    <!-- Pocket Service -->
    <java-symbol type="string" name="config_pocketJudgeVendorSensorName" />
    <java-symbol type="dimen" name="config_pocketJudgeVendorSensorValue" />
    <java-symbol type="string" name="config_pocketJudgeVendorProximitySensorName" />

    <!-- Lock gesture -->
    <java-symbol type="string" name="gesture_locked_warning" />

    <!-- GameSpace -->
    <java-symbol type="string" name="gamespace_new_game_added" />

    <!-- Health interface -->
    <java-symbol type="bool" name="config_chargingControlEnabled" />
    <java-symbol type="bool" name="config_chargingControlToggleSetAlways" />
    <java-symbol type="integer" name="config_defaultChargingControlMode" />
    <java-symbol type="integer" name="config_defaultChargingControlStartTime" />
    <java-symbol type="integer" name="config_defaultChargingControlTargetTime" />
    <java-symbol type="integer" name="config_defaultChargingControlLimit" />
    <java-symbol type="drawable" name="ic_charging_control" />
    <java-symbol type="integer" name="config_chargingControlTimeMargin" />
    <java-symbol type="integer" name="config_chargingControlBatteryRechargeMargin" />
    <java-symbol type="string" name="charging_control_notification_channel" />
    <java-symbol type="string" name="charging_control_notification_title" />
    <java-symbol type="string" name="charging_control_notification_cancel_once" />
    <java-symbol type="string" name="charging_control_notification_content_limit" />
    <java-symbol type="string" name="charging_control_notification_content_limit_reached" />
    <java-symbol type="string" name="charging_control_notification_content_target" />
    <java-symbol type="string" name="charging_control_notification_content_target_reached" />

    <!-- Whether devices suports in-display fingerprint when screen is off -->
    <java-symbol type="bool" name="config_supportScreenOffUdfps" />

    <!-- Landscape Battery -->
    <java-symbol type="string" name="config_batterymeterRLandPerimeterPath" />
    <java-symbol type="string" name="config_batterymeterRLandFillMask" />
    <java-symbol type="string" name="config_batterymeterRLandBoltPath" />
    <java-symbol type="string" name="config_batterymeterRLandPowersavePath" />
    <java-symbol type="string" name="config_batterymeterRLandErrorPerimeterPath" />
    <java-symbol type="string" name="config_batterymeterLandPerimeterPath" />
    <java-symbol type="string" name="config_batterymeterLandFillMask" />
    <java-symbol type="string" name="config_batterymeterLandBoltPath" />
    <java-symbol type="string" name="config_batterymeterLandPowersavePath" />
    <java-symbol type="string" name="config_batterymeterLandErrorPerimeterPath" />

    <!-- Absolute path of the DC dimming node -->
    <java-symbol type="string" name="config_dcdNodePath" />

    <!-- USB -->
    <java-symbol type="string" name="config_usbFunctionActivity" />

    <!-- Custom clocks -->
    <java-symbol type="dimen" format="float" name="presentation_clock_text_size" />
    <java-symbol type="dimen" format="float" name="large_clock_text_size" />
    <java-symbol type="dimen" format="float" name="small_clock_text_size" />
</resources>
