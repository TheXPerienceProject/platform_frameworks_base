<resources>

    <!-- Pocket Mode -->
    <style name="PocketModeTitle">
        <item name="android:textSize">@dimen/pocket_mode_title_size</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:alpha">0.85</item>
    </style>

    <style name="PocketModeInstructionsTitle">
        <item name="android:textSize">@dimen/pocket_mode_instructions_title_size</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:alpha">0.5</item>
    </style>

    <style name="PocketModeInstructionStep">
        <item name="android:textSize">@dimen/pocket_mode_instructions_step_size</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:alpha">0.5</item>
    </style>

    <!-- Custom clocks -->	
    <dimen name="presentation_clock_text_size">50dp</dimen>
    <dimen name="large_clock_text_size">150dp</dimen>
    <dimen name="small_clock_text_size">86dp</dimen>

    <!-- Blur radius used by SystemUI -->
    <dimen name="min_window_blur_radius">1px</dimen>
    <dimen name="max_window_blur_radius">17.5dp</dimen>
</resources>
